{
  "name": "dbgate-plugin-xml",
  "main": "dist/backend.js",
  "version": "7.0.0-alpha.1",
  "homepage": "https://www.dbgate.io",
  "description": "XML import/export plugin for DbGate",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbgate/dbgate"
  },
  "author": "Jan Prochazka",
  "license": "GPL-3.0",
  "keywords": [
    "xml",
    "import",
    "export",
    "dbgate",
    "dbgatebuiltin"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build:frontend": "webpack --config webpack-frontend.config",
    "build:frontend:watch": "webpack --watch --config webpack-frontend.config",
    "build:backend": "webpack --config webpack-backend.config.js",
    "build": "pnpm build:frontend && pnpm build:backend",
    "plugin": "pnpm build && pnpm pack && dbgate-plugin dbgate-plugin-xml",
    "copydist": "pnpm build && pnpm pack && dbgate-copydist ../dist/dbgate-plugin-xml",
    "plugout": "dbgate-plugout dbgate-plugin-xml",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "dbgate-plugin-tools": "^1.0.7",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "node-xml-stream-parser": "^1.0.12"
  }
}
